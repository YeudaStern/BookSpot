<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Action Bar (Safe padding from status bar + Modern Circular Action Buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.03"
            android:text="BookSpot"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="26sp" />

        <!-- Theme Toggle Button -->
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="?android:attr/colorButtonNormal"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <ImageButton
                android:id="@+id/btnToggleTheme"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dark Mode"
                android:padding="9dp"
                android:src="@drawable/ic_mode_night" />
        </androidx.cardview.widget.CardView>

        <!-- Favorites Filter Button -->
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="?android:attr/colorButtonNormal"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <ImageButton
                android:id="@+id/btnFilterFavorites"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favorites"
                android:padding="8dp"
                android:src="@drawable/ic_star_border" />
        </androidx.cardview.widget.CardView>

        <!-- Layout Mode Switcher Button -->
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="?android:attr/colorButtonNormal"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <ImageButton
                android:id="@+id/btnToggleLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Switch View Mode"
                android:padding="9dp"
                android:src="@drawable/ic_grid_view" />
        </androidx.cardview.widget.CardView>

        <!-- Profile Button -->
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="?android:attr/colorButtonNormal"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Profile"
                android:padding="9dp"
                android:src="@drawable/ic_user_avatar" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Floating Search Bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="?android:attr/textColorSecondary" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search title, author, topic..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <!-- כפתור חיפוש קולי (מיקרופון) -->
            <ImageButton
                android:id="@+id/btnVoiceSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voice Search"
                android:padding="5dp"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="?android:attr/textColorPrimary" />

            <!-- כפתור שליחת חיפוש -->
            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Submit Search"
                android:padding="5dp"
                android:src="@android:drawable/ic_menu_send"
                app:tint="?android:attr/textColorPrimary" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Category Chips Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipTech"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Technology"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipFiction"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Fiction"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipScience"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Science"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipHistory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="History"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chipPsychology"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Psychology"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Container: Either RecyclerView or Animated Loading -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBooks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="6dp" />

        <!-- Cool Animated Book Loading Container -->
        <LinearLayout
            android:id="@+id/layoutLoadingAnimation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivAnimatedBook"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Fetching books..."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>